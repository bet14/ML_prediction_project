"""
bayesian_search.py -- Bayesian hyperparameter search for GBP/USD direction models.

STATUS: production

Uses Optuna to find best hyperparameters for each model type.
Search runs on folds 1-4 combined (inner CV), fold 5 used as validation.
Best params saved to models/search_results/{model}_{dataset}_best_params.json.
Train with those params by running train.py afterwards (it auto-loads best_params).

Usage:
    python src/models/bayesian_search.py                          # RF only, 50 trials
    python src/models/bayesian_search.py --models LR RF --trials 100
    python src/models/bayesian_search.py --models RF XGB LGBM MLP --trials 80
"""

import argparse
import json
import os
import sys
import warnings

import numpy as np
import pandas as pd

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))

from src.evaluation.metrics import compute_metrics
from src.evaluation.walk_forward_cv import get_folds
from src.models.train import build_estimator, build_pipeline

warnings.filterwarnings("ignore")

PROCESSED_DIR = os.path.join(os.path.dirname(__file__), "..", "..", "data", "processed")
SEARCH_DIR = os.path.join(os.path.dirname(__file__), "..", "..", "models", "search_results")

DATASET_FILES = {
    "dataset_basic_daily": "dataset_basic_daily.csv",
    "dataset_90day_lookback": "dataset_90day_lookback.csv",
    "dataset_technical": "dataset_technical.csv",
}

# Folds 0-3 = inner search space; fold 4 = validation
SEARCH_FOLD_INDICES = [0, 1, 2, 3]
VALID_FOLD_INDEX = 4


def _suggest_params(trial, model_name: str) -> dict:
    """Suggest hyperparameters for one Optuna trial."""
    if model_name == "LR":
        return {
            "C": trial.suggest_float("C", 1e-3, 10.0, log=True),
            "penalty": trial.suggest_categorical("penalty", ["l1", "l2"]),
        }
    if model_name == "RF":
        return {
            "n_estimators": trial.suggest_int("n_estimators", 100, 500),
            "max_depth": trial.suggest_int("max_depth", 3, 20),
            "min_samples_leaf": trial.suggest_int("min_samples_leaf", 1, 20),
        }
    if model_name == "XGB":
        return {
            "n_estimators": trial.suggest_int("n_estimators", 100, 500),
            "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.3, log=True),
            "max_depth": trial.suggest_int("max_depth", 2, 8),
            "subsample": trial.suggest_float("subsample", 0.5, 1.0),
        }
    if model_name == "LGBM":
        return {
            "n_estimators": trial.suggest_int("n_estimators", 100, 500),
            "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.3, log=True),
            "num_leaves": trial.suggest_int("num_leaves", 15, 127),
        }
    if model_name == "MLP":
        n_layers = trial.suggest_int("n_layers", 1, 3)
        layer_size = trial.suggest_int("layer_size", 32, 256)
        hidden = tuple([layer_size] * n_layers)
        return {
            "hidden_layer_sizes": hidden,
            "learning_rate_init": trial.suggest_float("learning_rate_init", 1e-4, 1e-2, log=True),
            "alpha": trial.suggest_float("alpha", 1e-5, 1e-2, log=True),
        }
    raise ValueError(f"Unknown model: {model_name!r}")


def run_search(
    model_name: str,
    dataset_name: str = "dataset_basic_daily",
    n_trials: int = 50,
    verbose: bool = True,
) -> dict:
    """
    Run Bayesian search for one model type on one dataset.

    Optimises mean F1-macro across folds 1-4 (inner CV).
    Validates best params on fold 5.
    Saves result to models/search_results/{model}_{dataset}_best_params.json.

    Returns the best params dict.
    """
    try:
        import optuna
    except ImportError:
        raise ImportError("optuna not installed. Run: pip install optuna")

    optuna.logging.set_verbosity(optuna.logging.WARNING)

    csv_path = os.path.join(PROCESSED_DIR, DATASET_FILES[dataset_name])
    df = pd.read_csv(csv_path, index_col=0, parse_dates=True)
    folds = get_folds(df)

    if VALID_FOLD_INDEX >= len(folds):
        raise ValueError(f"Not enough folds for search (need at least {VALID_FOLD_INDEX+1})")

    search_folds = [folds[i] for i in SEARCH_FOLD_INDICES if i < len(folds)]
    X_val, y_val, X_test_val, y_test_val = folds[VALID_FOLD_INDEX]

    def objective(trial):
        params = _suggest_params(trial, model_name)
        scores = []
        for X_train, y_train, X_test, y_test in search_folds:
            pipe = build_pipeline(model_name, build_estimator(model_name, params))
            pipe.fit(X_train, y_train)
            y_pred = pipe.predict(X_test)
            m = compute_metrics(y_test, y_pred)
            scores.append(m["f1_macro"])
        return float(np.mean(scores))

    study = optuna.create_study(direction="maximize")
    study.optimize(objective, n_trials=n_trials, show_progress_bar=False)

    best_params = study.best_params

    # MLP: reconstruct hidden_layer_sizes tuple (Optuna stores n_layers + layer_size)
    if model_name == "MLP" and "n_layers" in best_params:
        n = best_params.pop("n_layers")
        size = best_params.pop("layer_size")
        best_params["hidden_layer_sizes"] = [size] * n  # JSON-serialisable list

    # Validate on fold 5
    pipe = build_pipeline(model_name, build_estimator(model_name, best_params))
    pipe.fit(X_val, y_val)
    y_pred_val = pipe.predict(X_test_val)
    val_metrics = compute_metrics(y_test_val, y_pred_val)

    if verbose:
        print(f"  [{model_name}] best trial f1={study.best_value:.4f} "
              f"| val acc={val_metrics['accuracy']:.3f} f1={val_metrics['f1_macro']:.3f} "
              f"| params={best_params}")

    os.makedirs(SEARCH_DIR, exist_ok=True)
    out_path = os.path.join(SEARCH_DIR, f"{model_name}_{dataset_name}_best_params.json")
    with open(out_path, "w") as f:
        json.dump(best_params, f, indent=2)

    return best_params


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Bayesian hyperparameter search")
    parser.add_argument(
        "--dataset", default="dataset_basic_daily",
        choices=list(DATASET_FILES.keys()),
    )
    parser.add_argument(
        "--models", nargs="+", default=["RF"],
        choices=["LR", "RF", "XGB", "LGBM", "MLP"],
    )
    parser.add_argument(
        "--trials", type=int, default=50,
        help="Number of Optuna trials per model (default 50)",
    )
    args = parser.parse_args()

    print(f"Dataset : {args.dataset}")
    print(f"Models  : {args.models}")
    print(f"Trials  : {args.trials}")
    print()

    all_best = {}
    for model_name in args.models:
        print(f"Searching {model_name}...")
        best = run_search(model_name, args.dataset, args.trials)
        all_best[model_name] = best

    print()
    print("=== Best params found ===")
    for m, p in all_best.items():
        print(f"  {m}: {p}")
    print(f"\nSaved to: models/search_results/")
